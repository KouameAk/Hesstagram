PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS `utilisateur` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `nom` VARCHAR(255),
    `mdp` TEXT NOT NULL,
    `date` DATETIME,
    `role` VARCHAR(255),
    `cle_publique` TEXT,
    `banni` BOOLEAN NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS `ami` (
    `id_utilisateur1` INTEGER,
    `id_utilisateur2` INTEGER,
    PRIMARY KEY (`id_utilisateur1`, `id_utilisateur2`),
    FOREIGN KEY (`id_utilisateur1`) REFERENCES `utilisateur` (`id`),
    FOREIGN KEY (`id_utilisateur2`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS publication (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    id_utilisateur INTEGER,
    date DATETIME,
    description TEXT,
    nom_fichier VARCHAR(255),
    type_fichier VARCHAR(255),
    vue INTEGER,
    "like" INTEGER,
    "dislike" INTEGER,
    partage INTEGER,
    republie BOOLEAN,

    FOREIGN KEY (id_utilisateur)
        REFERENCES utilisateur(id)
);

CREATE TABLE IF NOT EXISTS `conversation` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `type` VARCHAR(255) CHECK (`type` IN ('privee', 'groupe')),
    `nom` VARCHAR(255),
    `id_createur` INTEGER,
    `date` DATETIME,
    FOREIGN KEY (`id_createur`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `conversation_membre` (
    `id_conversation` INTEGER,
    `id_utilisateur` INTEGER,
    `date_ajout` DATETIME,
    PRIMARY KEY (`id_conversation`, `id_utilisateur`),
    FOREIGN KEY (`id_conversation`) REFERENCES `conversation` (`id`),
    FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `message` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `id_conversation` INTEGER,
    `id_utilisateur` INTEGER,
    `iv` TEXT,
    `ciphertext` TEXT,
    `auth_tag` TEXT,
    `date` DATETIME,
    `vue` BOOLEAN,
    FOREIGN KEY (`id_conversation`) REFERENCES `conversation` (`id`),
    FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `cle_groupe_partagee` (
    `id_conversation` INTEGER,
    `id_utilisateur` INTEGER,
    `iv` TEXT,
    `ciphertext` TEXT,
    `auth_tag` TEXT,
    PRIMARY KEY (`id_conversation`, `id_utilisateur`),
    FOREIGN KEY (`id_conversation`) REFERENCES `conversation` (`id`),
    FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `notification` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `nombre` INTEGER,
    `id_utilisateur` INTEGER,
    `message` TEXT,
    FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `hashtag` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `nom` VARCHAR(255),
    `nombre_utilisation` INTEGER,
    `id_pub` INTEGER,
    FOREIGN KEY (`id_pub`) REFERENCES `publication` (`id`)
);

CREATE TABLE IF NOT EXISTS `hashtag_interdit` (
    `nom` VARCHAR(255) PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS `signalement` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `id_signalé` INTEGER,
    `id_signalant` INTEGER,
    `raison` TEXT,
    `date` DATETIME,
    FOREIGN KEY (`id_signalé`) REFERENCES `utilisateur` (`id`),
    FOREIGN KEY (`id_signalant`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `like` (
    `id_pub` INTEGER,
    `id_utilisateur` INTEGER,
    PRIMARY KEY (`id_pub`, `id_utilisateur`),
    FOREIGN KEY (`id_pub`) REFERENCES `publication` (`id`),
    FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `dislike` (
    `id_pub` INTEGER,
    `id_util` INTEGER,
    PRIMARY KEY (`id_pub`, `id_util`),
    FOREIGN KEY (`id_pub`) REFERENCES `publication` (`id`),
    FOREIGN KEY (`id_util`) REFERENCES `utilisateur` (`id`)
);

CREATE TABLE IF NOT EXISTS `commentaire` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT,
    `id_pub` INTEGER,
    `id_utilisateur` INTEGER,
    `commentaire` TEXT,
    FOREIGN KEY (`id_pub`) REFERENCES `publication` (`id`),
    FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateur` (`id`)
);
